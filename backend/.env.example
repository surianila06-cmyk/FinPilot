# Groq API key for LLM financial extraction (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# development | production (production fails loudly instead of regex fallback)
APP_ENV=development

# Max PDF upload size in MB
MAX_UPLOAD_MB=10

# Comma-separated extra CORS origins
CORS_ALLOWED_ORIGINS=

# Regex of allowed CORS origins
CORS_ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app